      "name": "Madhukar Temba",
      "email": "madhusmiles.madhukar@gmail.com",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/madhukartemba/PixelEngine",
  "repository": {
    "type": "git",
    "url": "https://github.com/madhukartemba/PixelEngine.git"
  },
  "dependencies": [
    {
      "name": "Adafruit NeoPixel",
      "frameworks": "arduino"
    }
  ],
  "frameworks": ["arduino", "espidf"],
  "platforms": ["*"],
  "headers": "src/PixelEngine.h",
  "build": {
    "includeDir": "src"
  }
